{
  "checked": "2026-11-03",
  "scope": "Frozen incoming request schemas only. Provider and current template limits can differ; read parameters.md.",
  "routes": [
    {
      "source": "https://docs.comfy.org/router-schemas/minimax/minimax-h3.json",
      "method": "post",
      "path": "/v2/models/minimax/minimax-h3",
      "schema": {
        "properties": {
          "aigc_watermark": {
            "type": "boolean"
          },
          "callback_url": {
            "type": "string"
          },
          "content": {
            "items": {
              "$ref": "#/components/schemas/MinimaxV2ContentItem"
            },
            "type": "array"
          },
          "duration": {
            "maximum": 15,
            "minimum": 4,
            "type": "integer"
          },
          "model": {
            "nullable": true,
            "type": "string"
          },
          "ratio": {
            "type": "string"
          },
          "resolution": {
            "enum": [
              "2K",
              "2k",
              "768P",
              "768p"
            ],
            "type": "string"
          },
          "seed": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "content",
          "resolution",
          "duration"
        ],
        "type": "object"
      },
      "components": {
        "schemas": {
          "MinimaxV2ContentItem": {
            "properties": {
              "audio_url": {
                "properties": {
                  "url": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "image_url": {
                "properties": {
                  "url": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "role": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "video_url": {
                "properties": {
                  "url": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          }
        }
      }
    }
  ]
}